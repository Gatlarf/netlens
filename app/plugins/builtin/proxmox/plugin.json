{
  "id": "proxmox",
  "name": "Proxmox VE",
  "version": "1.3.0",
  "api_version": 1,
  "diagnose": true,
  "kind": "hypervisor",
  "author": "Netlens",
  "description": "Reads your Proxmox VMs and containers so the map and device pages show which devices run on which Proxmox host. Read-only.",
  "timeout": 120,
  "config": [
    {
      "key": "servers",
      "type": "servers",
      "label": "Proxmox servers",
      "required": true,
      "help": "The address of the web interface (HTTPS port 8006 is assumed when you leave the port out). Use an API token with the read-only PVEAuditor role (recommended), or a user and password.",
      "columns": [
        {
          "key": "host",
          "label": "Address",
          "placeholder": "https://192.168.0.10:8006",
          "required": true
        },
        {
          "key": "token_id",
          "label": "Token ID",
          "placeholder": "user@pam!netlens"
        },
        {
          "key": "token_secret",
          "label": "Token secret",
          "type": "password"
        },
        {
          "key": "username",
          "label": "Username",
          "placeholder": "root@pam",
          "optional": true
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "optional": true
        }
      ],
      "legacy": {
        "map": {
          "host": "url",
          "token_id": "token_id",
          "token_secret": "token_secret",
          "username": "username",
          "password": "password"
        }
      }
    },
    {
      "key": "verify_tls",
      "type": "bool",
      "label": "Verify TLS certificate",
      "default": true,
      "help": "Turn off for the self-signed certificate Proxmox uses by default."
    }
  ]
}
