# Netlens environment configuration
# Copy this file to .env and adjust the values.

# Everything in this file is optional: docker-compose.yml and docker-compose.simple.yml work without a .env.
# Copy it to .env (next to docker-compose.yml) only for the settings you want to change.

# Your time zone, so times in e-mails and charts match your clock.
#TZ=Europe/Brussels

# Keep the data in a folder of your own instead of the Docker volume "netlens-data".
# The folder must exist and be owned by uid 10001 (sudo chown 10001:10001 /srv/netlens).
#NETLENS_DATA=/srv/netlens

# Run a specific version instead of the newest (see https://github.com/Gatlarf/netlens/pkgs/container/netlens).
#NETLENS_IMAGE_TAG=0.3.128

# Optional. A shared access token that signs in as administrator (how older installs work).
# Leave it empty and you create your own account in the first-start wizard instead.
# Generate one with: openssl rand -hex 32
NETLENS_TOKEN=

# Optional. Comma-separated private CIDRs, no larger than /20.
# Example: 192.168.1.0/24,10.0.0.0/22
# Empty value means auto-detect from host interfaces.
NETLENS_RANGES=

# Quick scan interval in seconds. Minimum 60.
NETLENS_QUICK_INTERVAL=900

# Deep scan interval in seconds. Minimum 60.
NETLENS_DEEP_INTERVAL=86400

# Web terminal feature toggle. Values: on or off.
# Off removes the web terminal completely.
NETLENS_TERMINAL=on
# Where the terminal may be used from: off (default: direct local connections only, not through a reverse proxy), lan, any
#NETLENS_TERMINAL_REMOTE=off

# Reserved. SNMP/LLDP discovery is not implemented yet.
NETLENS_SNMP_COMMUNITY=

# Host:port the web UI listens on.
# Use 127.0.0.1:8080 behind a local reverse proxy.
NETLENS_BIND=0.0.0.0:8080